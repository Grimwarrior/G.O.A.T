{
    "Amazon": {
        "AssetProcessor": {
            "Settings": {
                "ScanFolder GOAT_Perception/Assets": {
                    "watch": "@GEMROOT:GOAT_Perception@/Assets",
                    "recursive": 1,
                    "order": 101
                },
                "ScanFolder GOAT_Perception/Registry": {
                    "watch": "@GEMROOT:GOAT_Perception@/Registry",
                    "recursive": 1,
                    "order": 102
                }
            }
        }
    }
}
